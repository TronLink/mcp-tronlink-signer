{
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/TronLink/mcp-tronlink-signer.git"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r build && pnpm -r test",
    "publish:all": "pnpm -r build && pnpm -r publish --access public --no-git-checks"
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "axios": "1.18.1",
      "body-parser": "2.3.0",
      "fast-uri": "3.1.8",
      "form-data": "4.0.6",
      "hono": "4.13.9",
      "ip-address": "10.7.2",
      "ws": "8.21.1",
      "qs": "6.16.0",
      "@hono/node-server": "1.19.15"
    }
  }
}
